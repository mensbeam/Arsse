{
    "name": "jkingweb/arsse",
    "type": "project",
    "description": "The clean and modern RSS server that doesn't give you any crap",
    "keywords": ["rss"],
    "license": "MIT",
    "authors": [
        {
            "name": "J. King",
            "email": "jking@jkingweb.ca",
            "homepage": "https://jkingweb.ca/"
        },
        {
            "name": "Dustin Wilson",
            "email": "dustin@dustinwilson.com",
            "homepage": "https://dustinwilson.com/"
        }

    ],
    "require": {
        "php": ">=7.3",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-hash": "*",
        "ext-filter": "*",
        "ext-dom": "*",
        "mensbeam/mimesniff": "^0.3.0",
        "jkingweb/druuid": "4.*",
        "hosteurope/password-generator": "1.*",
        "docopt/docopt": "^1.0.6",
        "nicolus/picofeed": "dev-arsse",
        "guzzlehttp/psr7": "2.*",
        "laminas/laminas-xml": "dev-fixup as 1.4.0",
        "laminas/laminas-httphandlerrunner": "2.*",
        "mensbeam/uri": "^1.0"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "*",
        "donatj/mock-webserver": "^2.10"
    },
    "suggest": {
        "ext-pcntl": "To respond to signals, particularly to reload configuration via SIGHUP"
    },
    "config": {
        "platform": {
            "php": "7.3.33",
            "ext-sockets": "7.3.33"
        },
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true
        }
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": true
        }
    },
    "autoload": {
        "psr-4": {
            "JKingWeb\\Arsse\\": "lib/"
        },
        "exclude-from-classmap": ["/vendor/symfony/polyfill-php80/Resources/stubs/ValueError.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "JKingWeb\\Arsse\\Test\\": "tests/lib/",
            "JKingWeb\\Arsse\\TestCase\\": "tests/cases/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/JKingweb/picoFeed-1/"
        },
        {
            "type": "vcs",
            "url": "https://github.com/JKingweb/laminas-xml/"
        }
    ],
    "scripts": {
        "test": ["./scripts/test test"],
        "test:quick": ["./scripts/test test:quick"],
        "test:full": ["./scripts/test test:full"],
        "coverage": ["./scripts/test coverage"],
        "coverage:full": ["./scripts/test coverage:full"],
        "clean": ["./vendor/bin/php-cs-fixer fix"],
        "manual": ["./vendor/bin/daux generate -d manual -q", "rm -rf manual/daux_libraries manual/theme manual/themes/src @no_additional_args"],
        "manual:live": ["Composer\\Config::disableProcessTimeout", "./vendor/bin/daux serve"],
        "package": ["@package:generic", "@package:debsrc"],
        "package:generic": ["./scripts/make-tarball"],
        "package:debsrc": ["./scripts/make-debsrc"]
    },
    "scripts-descriptions": {
        "test": "Executes the PHPUnit test suite excluding optional tests",
        "test:quick": "Executes the PHPUnit test suite excluding optional and slow tests",
        "test:full": "Executes the PHPUnit test suite excluding no tests",
        "coverage": "Executes the PHPUnit test suite and produces a code coverage report, excluding tests redundant to coverage",
        "coverage:full": "Executes the PHPUnit test suite and produces a code coverage report, excluding no tests",
        "clean": "Corrects defifiencies in coding style",
        "manual": "Produces the static HTML manual from the Markdown source files",
        "manual:live": "Serves the manual on a basic HTTP server on port 8085",
        "package": "Produces all relevant release artefacts",
        "package:generic": "Produces the main release tarball",
        "package:debsrc": "Produces a Debian source package with related files"
    }
}
